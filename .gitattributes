# Normalize line endings: store as LF in the repo, check out native on Windows.
# Keeps diffs clean for a repo that may go public.
* text=auto eol=lf

# Windows batch/PowerShell scripts want CRLF locally.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary / data artifacts — never touch line endings.
*.duckdb binary
*.7z binary
*.png binary
