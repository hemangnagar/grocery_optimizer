# Copy to .env and fill in. NEVER set these as global Windows env vars:
# this machine also runs trading bots, and a global ANTHROPIC_API_KEY would
# make Claude Code bill API rates instead of the subscription.

# Anthropic (agentic layer — parser self-healing, entity adjudicator, narrator)
ANTHROPIC_API_KEY=

# Kroger Developer API (OAuth2 client-credentials)
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# User home location — the store comparison set is limited to stores within
# SEARCH_RADIUS_MILES of HOME_ZIP. Defaults: Vienna, VA / 5 miles.
HOME_ZIP=22180
SEARCH_RADIUS_MILES=5

# Exact home coordinates (optional). Overrides the built-in DC-metro
# zip-centroid geocode; REQUIRED if HOME_ZIP is outside that table
# (see silver/geo.py). Leave blank to use the centroid.
HOME_LAT=
HOME_LON=

# Whole Foods store id for the home area (default: Vienna, VA).
WFM_STORE_ID=10065

# Kroger (Harris Teeter) location id for the home area (default: Dunn Loring).
KROGER_STORE_ID=09700308
